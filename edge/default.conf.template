server_tokens off;

server {
    listen 8080;
    root /usr/share/nginx/html;

    # Keep add_header out of locations: any add_header there drops all of these.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;
    # script-src 'unsafe-eval': the editor's AJV validation compiles schemas via new Function.
    # style-src 'unsafe-inline': Monaco injects inline styles. Everything else is same-origin
    # (connect-src 'self' also covers the /validate path).
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-eval' ${CSP_SCRIPT_HASHES}; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'" always;

    location = /.well-known/appspecific/de.bsi.secvisogram.json {
        default_type application/json;
        expires -1;
        return 200 '{"loginAvailable":true,"loginUrl":"${EDGE_ORIGIN}/oauth2/sign_in","logoutUrl":"${EDGE_ORIGIN}/oauth2/sign_out?rd=${EDGE_ORIGIN_ENCODED}%2Frealms%2Fcsaf%2Fprotocol%2Fopenid-connect%2Flogout%3Fpost_logout_redirect_uri%3D${EDGE_ORIGIN_ENCODED}%26client_id%3Dsecvisogram","userInfoUrl":"${EDGE_ORIGIN}/oauth2/userinfo","validatorUrl":"/validate"}';
    }

    location ^~ /secvisogram-editor/ {
        try_files $uri =404;
    }

    location ^~ /assets/ {
        expires 1y;
        try_files $uri =404;
    }

    location / {
        expires -1;
        try_files $uri /index.html;
    }
}
